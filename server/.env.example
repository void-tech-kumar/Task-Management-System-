# Server Runtime Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL Database Connections
# DATABASE_URL uses pooled connection (port 6543 or -pooler) for serverless queries
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.neon.tech/neondb?sslmode=require"
# DIRECT_URL uses direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="TaskFlow Academic Portal <noreply@taskflow.edu>"

# OTP HMAC Hashing Secret (Hex string)
OTP_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Neon S3-Compatible Object Storage (Optional for submissions)
AWS_ENDPOINT_URL_S3=https://[STORAGE_HOST].neon.tech
AWS_ACCESS_KEY_ID=nak_your_access_key_id
AWS_SECRET_ACCESS_KEY=nsk_your_secret_access_key
AWS_REGION=us-east-1
